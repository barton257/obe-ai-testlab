# Spartans 自动化测试凭证模板
# cp shared/secrets/spartans.example.env .env.local 并填入真实值

# ── API ──
SPARTANS_API_BASE=https://bullapitest.1bullex.com
SPARTANS_FRONTEND_BASE=https://testnet.1bullex.com

# ── 订阅者账号 ──
USER1_EMAIL=<email>
USER1_PASSWORD=<password>
USER1_UID=<uid>

USER2_EMAIL=<email>
USER2_PASSWORD=<password>
USER2_UID=<uid>

USER3_EMAIL=<email>
USER3_PASSWORD=<password>
USER3_UID=<uid>

# ── 专用资金账户（动账用例专用，不要与 USER1/2/3 混用）──
# 所有资金变动必须记入 projects/spartans/funds/ 台账
FUNDS_EMAIL=<email>
FUNDS_PASSWORD=<password>
FUNDS_UID=<uid>

# ── 机器人账号（aibot.{uid}.{botId}@onebullex.com）──
BOT1_EMAIL=<bot_email>
BOT1_PASSWORD=<password>
BOT1_ID=<botId>

BOT2_EMAIL=<bot_email>
BOT2_PASSWORD=<password>
BOT2_ID=<botId>

# ── 运行时 JWT（由登录接口刷新，不要手填）──
# 测试框架启动时自动写入，不要在此处硬编码
AUTH_TOKEN=
USER2_AUTH_TOKEN=
USER3_AUTH_TOKEN=
# 资金账户 token，刷新：
#   python scripts/spartans_login.py --user FUNDS --otp 123456 --key FUNDS_AUTH_TOKEN
FUNDS_AUTH_TOKEN=
