# Spartans 自动化测试凭证模板
# cp shared/secrets/spartans.example.env .env.local 并填入真实值

# ── API ──
SPARTANS_API_BASE=https://bullapitest.1bullex.com
SPARTANS_FRONTEND_BASE=https://testnet.1bullex.com

# ── 订阅者账号 ──
USER1_EMAIL=<email>
USER1_PASSWORD=<password>
USER1_UID=<uid>

USER2_EMAIL=<email>
USER2_PASSWORD=<password>
USER2_UID=<uid>

USER3_EMAIL=<email>
USER3_PASSWORD=<password>
USER3_UID=<uid>

# ── 机器人账号（aibot.{uid}.{botId}@onebullex.com）──
BOT1_EMAIL=<bot_email>
BOT1_PASSWORD=<password>
BOT1_ID=<botId>

BOT2_EMAIL=<bot_email>
BOT2_PASSWORD=<password>
BOT2_ID=<botId>

# ── 运行时 JWT（由登录接口刷新，不要手填）──
# 测试框架启动时自动写入，不要在此处硬编码
AUTH_TOKEN=
